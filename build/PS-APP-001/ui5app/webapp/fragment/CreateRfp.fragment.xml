<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout.form">
	<Dialog title="{i18n>createTitle}" contentWidth="30rem">
		<content>
			<l:SimpleForm editable="true" layout="ResponsiveGridLayout">
				<Label text="{i18n>fieldName}" required="true" />
				<Input value="{new>/RfpName}" maxLength="100" />
				<Label text="{i18n>fieldCustomer}" required="true" />
				<Input value="{new>/CustomerName}" maxLength="100" />
				<Label text="{i18n>fieldOwner}" />
				<Input value="{new>/OwnerUser}" maxLength="12" />
			</l:SimpleForm>
		</content>
		<beginButton>
			<Button type="Emphasized" text="{i18n>ok}" press=".onCreateConfirm" />
		</beginButton>
		<endButton>
			<Button text="{i18n>cancel}" press=".onCreateCancel" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
