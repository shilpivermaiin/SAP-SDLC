<mvc:View
	controllerName="zps.rfpeffortmgmt.controller.RateMaster"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m">
	<Page title="{i18n>rateTitle}" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<Table
				id="rateTable"
				items="{
					path: 'rate>/CostRate',
					sorter: [{ path: 'SapModule' }, { path: 'Role' }]
				}">
				<headerToolbar>
					<OverflowToolbar>
						<ToolbarSpacer />
						<Button text="{i18n>rateAdd}" icon="sap-icon://add" type="Emphasized" press=".onAdd" />
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column><Text text="{i18n>colModule}" /></Column>
					<Column><Text text="{i18n>colRole}" /></Column>
					<Column hAlign="End"><Text text="{i18n>colRate}" /></Column>
					<Column width="6rem"><Text text="{i18n>colCurrency}" /></Column>
					<Column width="3rem" />
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{rate>SapModule}" />
							<Text text="{rate>Role}" />
							<Input value="{rate>Rate}" textAlign="End" />
							<Input value="{rate>Currency}" maxLength="5" />
							<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>deleteLine}" press=".onDelete" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>
