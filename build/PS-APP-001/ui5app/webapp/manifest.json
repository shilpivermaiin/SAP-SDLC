{
  "_version": "1.60.0",
  "sap.app": {
    "id": "zps.rfpeffortmgmt",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zpseffrthdr_o4/srvd/sap/z_ui_pseffrthdr/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "rateService": {
        "uri": "/sap/opu/odata4/sap/zpseffrtrate_o4/srvd/sap/z_ui_pseffrtrate/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "manageEffort": {
          "semanticObject": "ZPSEffort",
          "action": "manage",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "zps.rfpeffortmgmt.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.layout": {},
        "sap.ui.export": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zps.rfpeffortmgmt.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      },
      "rate": {
        "dataSource": "rateService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "zps.rfpeffortmgmt.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "list",
          "pattern": "",
          "target": "list"
        },
        {
          "name": "detail",
          "pattern": "rfp/{effortId}",
          "target": "detail"
        },
        {
          "name": "dashboard",
          "pattern": "dashboard",
          "target": "dashboard"
        },
        {
          "name": "rates",
          "pattern": "rates",
          "target": "rates"
        }
      ],
      "targets": {
        "list": {
          "viewName": "List",
          "viewId": "list"
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail"
        },
        "dashboard": {
          "viewName": "Dashboard",
          "viewId": "dashboard"
        },
        "rates": {
          "viewName": "RateMaster",
          "viewId": "rates"
        }
      }
    }
  }
}
